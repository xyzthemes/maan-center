# Optional: connect your own Directus instance. Leave blank to use bundled fallback content.
NUXT_PUBLIC_DIRECTUS_URL=
NUXT_SITE_URL=http://127.0.0.1:3000
NUXT_SITE_INDEXABLE=false
# Optional: enables signed dynamic OG image generation.
# Without this, the app uses Nuxt OG Image zero-runtime mode.
# Generate with: npx nuxt-og-image generate-secret
# NUXT_OG_IMAGE_SECRET=
