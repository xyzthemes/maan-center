NUXT_SITE_URL=http://127.0.0.1:3000
NUXT_SITE_INDEXABLE=false
# Optional: enables signed dynamic OG image generation.
# Without this, the app uses Nuxt OG Image zero-runtime mode.
# Generate with: npx nuxt-og-image generate-secret
# NUXT_OG_IMAGE_SECRET=

# Fly Postgres (local dev needs `fly proxy 5432 -a maan-db` running)
DATABASE_URL=

# Fly Tigris (object storage / CDN)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
AWS_ENDPOINT_URL_S3=https://fly.storage.tigris.dev
BUCKET_NAME=

# Better Auth — min 32 chars; generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3000
