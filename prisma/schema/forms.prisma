// Public-facing forms (contact, etc.) and their submissions.
// The shape mirrors Directus's forms / form_fields / form_submissions /
// form_submission_values collections so Phase 3's seed is a straight copy.

model Form {
  id   String @id @default(uuid(7))
  // Stable public slug for `/forms/<slug>` (and `/ar/forms/<slug>`).
  // Admin chooses it in the dashboard; uniqueness enforced at the DB level.
  slug String @unique

  // Bilingual envelope: { en, ar }. Stored as JSONB; resolved per
  // request locale via `pickLocale` (see app/utils/i18n-text.ts).
  title       Json
  isActive    Boolean @default(true)
  submitLabel Json? // { en, ar }

  // Behavior after a successful submit: show a message inline, or redirect.
  onSuccess          String  @default("message")
  successMessage     Json? // { en, ar }
  successRedirectUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fields      FormField[]
  submissions FormSubmission[]
  blocks      FormBlock[]
}

// Stored block content shown on public pages (home, contact, blog) that wraps
// a form with a localized headline/tagline. Mirrors Directus's block_form
// collection so editors can change copy without a code deploy.
model FormBlock {
  id     String @id @default(uuid(7))
  formId String
  form   Form   @relation(fields: [formId], references: [id], onDelete: Cascade)
  // Bilingual envelopes: { en, ar }.
  headline Json?
  tagline  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([formId])
}

model FormField {
  id     String @id @default(uuid(7))
  formId String
  form   Form   @relation(fields: [formId], references: [id], onDelete: Cascade)

  // Field machine name — used as the key on submission values
  name String

  // Free-form type string ("text" | "email" | "textarea" | "select" | "checkbox" | ...).
  // Kept loose to match Directus and avoid migrations every time editors add a field type.
  type String

  // Bilingual envelopes: { en, ar }.
  label       Json?
  placeholder Json?
  help        Json?

  // Layout width ("full" | "half" | etc.) — UI hint, not enforced.
  width String?

  // Validation rule string (regex, or a built-in name like "email"). Loose by design.
  validation String?

  // Choices for select/radio fields. Bilingual shape: [{ value, text: { en, ar } }].
  // Legacy rows with [{ value, text: "..." }] still resolve via pickLocale().
  choices Json?

  required Boolean @default(false)
  sort     Int?

  values FormSubmissionValue[]

  @@index([formId, sort])
}

model FormSubmission {
  id     String @id @default(uuid(7))
  formId String
  form   Form   @relation(fields: [formId], references: [id], onDelete: Cascade)

  timestamp DateTime @default(now())

  // Locale the submitter used. Drives which side of every bilingual
  // field label gets snapshot into FormSubmissionValue.label, so an
  // Arabic admin reading an Arabic submission sees Arabic labels.
  locale String @default("en")

  // Optional context captured at submit time (IP, user-agent, referer) — useful for spam triage
  ipAddress String?
  userAgent String?

  values FormSubmissionValue[]

  @@index([formId, timestamp])
}

model FormSubmissionValue {
  id           String         @id @default(uuid(7))
  submissionId String
  submission   FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  // Nullable field FK: if a form's field is deleted later, its historical submissions stay
  // (their value still lives on as a raw string + label snapshot below).
  fieldId String?
  field   FormField? @relation(fields: [fieldId], references: [id], onDelete: SetNull)

  // Snapshot of the field's name + label at submit time — survives later field deletions.
  name  String
  label String

  value String?

  @@index([submissionId])
}
